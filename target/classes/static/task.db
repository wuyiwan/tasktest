drop table if exists task;
create table task
(
    id integer primary key autoincrement not null,
    level  varchar(20),
    description varchar(100),
    date varchar(11),
    pic varchar(10),
    image_path varchar(255),
    description_detail text
);
create index idindex on task(id);
